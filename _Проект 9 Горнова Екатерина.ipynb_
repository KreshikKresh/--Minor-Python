{"cell_type":"code","source":["corr_matrix = sns.heatmap(df[['Stress_Level_Numeric','Study_Hours_Per_Day','Extracurricular_Hours_Per_Day','Sleep_Hours_Per_Day', 'Social_Hours_Per_Day', 'Physical_Activity_Hours_Per_Day','Grades']].corr(), cmap=\"coolwarm\", annot=True, fmt=\".3f\")\n","corr_matrix;"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":648},"id":"Lu5tqd1RJoXG","executionInfo":{"status":"ok","timestamp":1777472255022,"user_tz":-180,"elapsed":421,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}},"outputId":"dde2af67-5909-42ff-f02f-503e3ffca4a7"},"execution_count":34,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["##Вывод: Самая высокая корреляция между временем, затраченным на учёбу, и оценками(0,739), в то время как самая сильная отрицательная корреляция у времени на учёбу и на физическую активность(-0,488)"],"metadata":{"id":"DB_JuFDtBS6i"}},{"cell_type":"markdown","source":["#Анализ влияния характеристик студентов на уровень стресса с помощью статистических гипотез"],"metadata":{"id":"f1jOD6lCMnXY"}},{"cell_type":"markdown","source":["## Гипотеза №1\n","\n","H0 (Нулевая гипотеза): Уровень стресса не зависит от пола.\n","\n","H1 (Альтернативная гипотеза): Есть зависимость между полом и уровнем стресса.\n","\n","Используем критерий независимости хи-квадрат для анализа.\n","\n","Критерий независимости хи-квадрат проверяет, есть ли связь между двумя категориальными переменными. Переменные зависимы, если связь есть, если нет - независимы.\n"],"metadata":{"id":"7AAa8hprw9d9"}},{"cell_type":"markdown","source":["Отсортируем Stress Level"],"metadata":{"id":"c7Gevf44xt_r"}},{"cell_type":"code","source":["df['Stress_Level'] = pd.Categorical(df['Stress_Level'], categories=['High', 'Moderate', 'Low'], ordered=True)"],"metadata":{"id":"NLQ4V11gw5nY","executionInfo":{"status":"ok","timestamp":1777472255029,"user_tz":-180,"elapsed":3,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}}},"execution_count":35,"outputs":[]},{"cell_type":"markdown","source":["Создадим таблицу частот"],"metadata":{"id":"92Mwm1ZvxGqZ"}},{"cell_type":"code","source":["contingency_table = pd.crosstab(df['Gender'], df['Stress_Level'], margins=True, margins_name='Сумма')\n","contingency_table"],"metadata":{"id":"TSI4ECzFvkdR","colab":{"base_uri":"https://localhost:8080/","height":174},"executionInfo":{"status":"ok","timestamp":1777472255049,"user_tz":-180,"elapsed":13,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}},"outputId":"3332968e-9893-4bbe-ecfe-dd2d8cd46cf4"},"execution_count":36,"outputs":[{"output_type":"execute_result","data":{"text/plain":["Stress_Level  High  Moderate  Low  Сумма\n","Gender                                  \n","Female         497       337  150    984\n","Male           532       337  147   1016\n","Сумма         1029       674  297   2000"],"text/html":["\n","  <div id=\"df-ee267d45-c529-483b-925e-d81dbc4d20ba\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th>Stress_Level</th>\n","      <th>High</th>\n","      <th>Moderate</th>\n","      <th>Low</th>\n","      <th>Сумма</th>\n","    </tr>\n","    <tr>\n","      <th>Gender</th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>Female</th>\n","      <td>497</td>\n","      <td>337</td>\n","      <td>150</td>\n","      <td>984</td>\n","    </tr>\n","    <tr>\n","      <th>Male</th>\n","      <td>532</td>\n","      <td>337</td>\n","      <td>147</td>\n","      <td>1016</td>\n","    </tr>\n","    <tr>\n","      <th>Сумма</th>\n","      <td>1029</td>\n","      <td>674</td>\n","      <td>297</td>\n","      <td>2000</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>\n","    <div class=\"colab-df-buttons\">\n","\n","  <div class=\"colab-df-container\">\n","    <button class=\"colab-df-convert\" onclick=\"convertToInteractive('df-ee267d45-c529-483b-925e-d81dbc4d20ba')\"\n","            title=\"Convert this dataframe to an interactive table.\"\n","            style=\"display:none;\">\n","\n","  <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\" viewBox=\"0 -960 960 960\">\n","    <path d=\"M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm220 220h160v-160H400v160Zm0 220h160v-160H400v160ZM180-400h160v-160H180v160Zm440 0h160v-160H620v160ZM180-180h160v-160H180v160Zm440 0h160v-160H620v160Z\"/>\n","  </svg>\n","    </button>\n","\n","  <style>\n","    .colab-df-container {\n","      display:flex;\n","      gap: 12px;\n","    }\n","\n","    .colab-df-convert {\n","      background-color: #E8F0FE;\n","      border: none;\n","      border-radius: 50%;\n","      cursor: pointer;\n","      display: none;\n","      fill: #1967D2;\n","      height: 32px;\n","      padding: 0 0 0 0;\n","      width: 32px;\n","    }\n","\n","    .colab-df-convert:hover {\n","      background-color: #E2EBFA;\n","      box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\n","      fill: #174EA6;\n","    }\n","\n","    .colab-df-buttons div {\n","      margin-bottom: 4px;\n","    }\n","\n","    [theme=dark] .colab-df-convert {\n","      background-color: #3B4455;\n","      fill: #D2E3FC;\n","    }\n","\n","    [theme=dark] .colab-df-convert:hover {\n","      background-color: #434B5C;\n","      box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\n","      filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\n","      fill: #FFFFFF;\n","    }\n","  </style>\n","\n","    <script>\n","      const buttonEl =\n","        document.querySelector('#df-ee267d45-c529-483b-925e-d81dbc4d20ba button.colab-df-convert');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      async function convertToInteractive(key) {\n","        const element = document.querySelector('#df-ee267d45-c529-483b-925e-d81dbc4d20ba');\n","        const dataTable =\n","          await google.colab.kernel.invokeFunction('convertToInteractive',\n","                                                    [key], {});\n","        if (!dataTable) return;\n","\n","        const docLinkHtml = 'Like what you see? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","variable_name":"contingency_table","summary":"{\n  \"name\": \"contingency_table\",\n  \"rows\": 3,\n  \"fields\": [\n    {\n      \"column\": \"Gender\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"Female\",\n          \"Male\",\n          \"\\u0421\\u0443\\u043c\\u043c\\u0430\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"High\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 297,\n        \"min\": 497,\n        \"max\": 1029,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          497,\n          532,\n          1029\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Moderate\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 194,\n        \"min\": 337,\n        \"max\": 674,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          674,\n          337\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Low\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 85,\n        \"min\": 147,\n        \"max\": 297,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          150,\n          147\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"\\u0421\\u0443\\u043c\\u043c\\u0430\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 577,\n        \"min\": 984,\n        \"max\": 2000,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          984,\n          1016\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":36}]},{"cell_type":"markdown","source":["Рассчитаем критерий независимости"],"metadata":{"id":"4rLNzFlKzhhP"}},{"cell_type":"code","source":["from scipy.stats import chi2   # хи-квадрат\n","\n","#Вычислим Kn\n","Kn = 2000*(497**2/(1029*984)+150**2/(297*984)+337**2/(674*984)+532**2/(1029*1016)+147**2/(297*1016)+337**2/(674*1016)-1)\n","r = 2-1\n","m = 3-1\n","alpha = 0.05\n","\n","# Вычисляем z критическое\n","z_critical_005 = chi2.ppf(1-alpha, r*m)\n","\n","if z_critical_005 > Kn:\n","  print(f\"Условие: {z_critical_005:.4f} > {Kn:.4f} выполняется\")\n","  print('Гипотеза не отвергается на уровне значимости',alpha)\n","else:\n","  print(f\"Условие: {z_critical_005:.4f} > {Kn:.4f}  не выполняется\")\n","  print('Гипотеза отвергается на уровне значимости', alpha)"],"metadata":{"id":"aWw_heaEPLWM","colab":{"base_uri":"https://localhost:8080/"},"outputId":"54c946e3-d12d-456c-b36b-ec36fe4806b6","executionInfo":{"status":"ok","timestamp":1777472255087,"user_tz":-180,"elapsed":33,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}}},"execution_count":37,"outputs":[{"output_type":"stream","name":"stdout","text":["Условие: 5.9915 > 0.7090 выполняется\n","Гипотеза не отвергается на уровне значимости 0.05\n"]}]},{"cell_type":"markdown","source":["##Вывод: Гипотеза H0 не отвергается на уровне значимости 0,05. Уровень стресса не зависит от пола."],"metadata":{"id":"ff5kPx-v5wln"}},{"cell_type":"markdown","source":["## Гипотеза №2\n","\n","H0 (Нулевая гипотеза): Уровень стресса не зависит от продолжительности сна.\n","\n","H1 (Альтернативная гипотеза): Уровень стресса зависит от продолжительности сна.\n","\n","Считается, что нужно студентам нужно спать около 8 часов в сутки. Разделим студентов на две группы: тех, кто спит меньше 8 часов и тех, что спит 8 и больше часов в сутки.\n","Используем критерий независимости хи-квадрат для анализа.\n"],"metadata":{"id":"KiBs3T0PCchi"}},{"cell_type":"markdown","source":["Создадим таблицу частот"],"metadata":{"id":"fue2CIfhDRc7"}},{"cell_type":"code","source":["frequency_table = pd.crosstab(df['Sleep_Hours_Per_Day'].apply(lambda x: 'sleep hours >=8' if x >= 8 else 'sleep hours <8'), df['Stress_Level'], margins=True, margins_name='Сумма')\n","frequency_table"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":174},"id":"yjmnIKqJDXoR","executionInfo":{"status":"ok","timestamp":1777472255097,"user_tz":-180,"elapsed":7,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}},"outputId":"b8dcedc5-e958-4eed-8100-021c2308666f"},"execution_count":38,"outputs":[{"output_type":"execute_result","data":{"text/plain":["Stress_Level         High  Moderate  Low  Сумма\n","Sleep_Hours_Per_Day                            \n","sleep hours <8        690       341  138   1169\n","sleep hours >=8       339       333  159    831\n","Сумма                1029       674  297   2000"],"text/html":["\n","  <div id=\"df-33eab825-f189-4f42-9c8f-12160c98c276\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th>Stress_Level</th>\n","      <th>High</th>\n","      <th>Moderate</th>\n","      <th>Low</th>\n","      <th>Сумма</th>\n","    </tr>\n","    <tr>\n","      <th>Sleep_Hours_Per_Day</th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>sleep hours &lt;8</th>\n","      <td>690</td>\n","      <td>341</td>\n","      <td>138</td>\n","      <td>1169</td>\n","    </tr>\n","    <tr>\n","      <th>sleep hours &gt;=8</th>\n","      <td>339</td>\n","      <td>333</td>\n","      <td>159</td>\n","      <td>831</td>\n","    </tr>\n","    <tr>\n","      <th>Сумма</th>\n","      <td>1029</td>\n","      <td>674</td>\n","      <td>297</td>\n","      <td>2000</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>\n","    <div class=\"colab-df-buttons\">\n","\n","  <div class=\"colab-df-container\">\n","    <button class=\"colab-df-convert\" onclick=\"convertToInteractive('df-33eab825-f189-4f42-9c8f-12160c98c276')\"\n","            title=\"Convert this dataframe to an interactive table.\"\n","            style=\"display:none;\">\n","\n","  <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\" viewBox=\"0 -960 960 960\">\n","    <path d=\"M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm22