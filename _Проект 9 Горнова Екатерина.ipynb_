com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","variable_name":"frequency_table","summary":"{\n  \"name\": \"frequency_table\",\n  \"rows\": 3,\n  \"fields\": [\n    {\n      \"column\": \"Sleep_Hours_Per_Day\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"sleep hours <8\",\n          \"sleep hours >=8\",\n          \"\\u0421\\u0443\\u043c\\u043c\\u0430\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"High\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 345,\n        \"min\": 339,\n        \"max\": 1029,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          690,\n          339,\n          1029\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Moderate\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 194,\n        \"min\": 333,\n        \"max\": 674,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          341,\n          333,\n          674\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Low\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 86,\n        \"min\": 138,\n        \"max\": 297,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          138,\n          159,\n          297\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"\\u0421\\u0443\\u043c\\u043c\\u0430\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 601,\n        \"min\": 831,\n        \"max\": 2000,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          1169,\n          831,\n          2000\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":38}]},{"cell_type":"code","source":["#Вычислим Kn\n","Kn = 2000*(690**2/(1029*1169)+341**2/(674*1169)+138**2/(297*1169)+339**2/(1029*831)+333**2/(674*831)+159**2/(297*831)-1)\n","r = 2-1\n","m = 3-1\n","alpha = 0.05\n","\n","# Вычисляем z критическое\n","z_critical_005 = chi2.ppf(1-alpha, r*m)\n","\n","if z_critical_005 > Kn:\n","  print(f\"Условие: {z_critical_005:.4f} > {Kn:.4f} выполняется\")\n","  print('Гипотеза не отвергается на уровне значимости',alpha)\n","else:\n","  print(f\"Условие: {z_critical_005:.4f} > {Kn:.4f}  не выполняется\")\n","  print('Гипотеза отвергается на уровне значимости', alpha)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Fv19Es_YDq10","executionInfo":{"status":"ok","timestamp":1777472255140,"user_tz":-180,"elapsed":39,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}},"outputId":"18264c1d-6771-44ad-ac5b-ce5f417154cf"},"execution_count":39,"outputs":[{"output_type":"stream","name":"stdout","text":["Условие: 5.9915 > 66.0738  не выполняется\n","Гипотеза отвергается на уровне значимости 0.05\n"]}]},{"cell_type":"markdown","source":["##Вывод: Гипотеза H0 отклоняется в пользу H1 на уровне значимости 0,05. Уровень стресса зависит от продолжительности сна. Судя по таблице, у студентов с низкой продолжительностью сна уровень стресса выше."],"metadata":{"id":"vVf1hR3QDsEz"}},{"cell_type":"markdown","source":["## Гипотеза №3\n","\n","Проверим, отличается ли среднее количество часов учебы (Study_Hours_Per_Day) у студентов с высоким уровнем стресса, от общего среднего, и является ли это отклонение значимым в сторону увеличения.\n","\n","H0: Среднее количество часов учебы у студентов с высоким уровнем стресса равно общему среднему.\n","\n","H1: Среднее количество часов учебы у студентов с высоким уровнем стресса выше, чем общее среднее в выборке.\n","\n","Используем критерий проверки средних.\n","\n","Критерий проверки средних для проверки гипотез о среднем значении. Измеряет, насколько далеко среднее значение выборки находится от предполагаемого среднего.\n","\n","\n","\n"],"metadata":{"id":"ZdP1iGzR7ugK"}},{"cell_type":"code","source":["# Вычисляем средние\n","mean_hours = df['Study_Hours_Per_Day'].mean()\n","h_level = df[df['Stress_Level'] == \"High\"]['Study_Hours_Per_Day']\n","print(\"Общее среднее количество часов учёбы:\",mean_hours.round(3))\n","print(\"Среднее у студентов с высоким уровнем стресса:\",h_level.mean().round(3))\n"],"metadata":{"id":"ZI4AlIY6xYHn","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1777472255200,"user_tz":-180,"elapsed":56,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}},"outputId":"587b7ea4-456c-4de7-ae31-e509538335f9"},"execution_count":40,"outputs":[{"output_type":"stream","name":"stdout","text":["Общее среднее количество часов учёбы: 7.476\n","Среднее у студентов с высоким уровнем стресса: 8.385\n"]}]},{"cell_type":"code","source":["delta  = ((h_level.mean()- mean_hours)*math.sqrt(h_level.count()))/h_level.std()\n","\n","alpha = 0.05  # уровень значимости\n","\n","from scipy.stats import t     # Используем формулу Стьюдента, так как не знаем стандартное отклонение генеральной совокупности\n","t_critical = t.ppf(1 - alpha, h_level.count()-1)\n","print(f\"Критическое значение: {t_critical.round(3)}\")\n","if t_critical > delta:\n","    print(f\"Условие: {t_critical:.4f} > {delta:.4f} выполняется\")\n","    print(f\"Гипотеза не отвергается на уровне значимости {alpha}\")\n","else:\n","    print(f\"Условие: {t_critical:.4f} > {delta:.4f} не выполняется\")\n","    print(f\"Гипотеза отвергнута на уровне значимости {alpha}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xSL6G-esOGSQ","outputId":"f680d853-e2ba-4e03-d74a-727b610c7417","executionInfo":{"status":"ok","timestamp":1777472255277,"user_tz":-180,"elapsed":36,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}}},"execution_count":41,"outputs":[{"output_type":"stream","name":"stdout","text":["Критическое значение: 1.646\n","Условие: 1.6463 > 23.5534 не выполняется\n","Гипотеза отвергнута на уровне значимости 0.05\n"]}]},{"cell_type":"markdown","source":["##Вывод: Гипотеза H0 отклоняется в пользу H1 на уровне значимости 0,05. Среднее количество часов учебы у студентов с высоким уровнем стресса значимо выше, чем общее среднее в выборке."],"metadata":{"id":"k495FrijBUNl"}},{"cell_type":"markdown","source":["## Гипотеза №4\n","\n","Проверим, отличается ли среднее время общения(Social_Hours_Per_Day) у студентов с высоким уровнем стресса, от общего среднего, и является ли это отклонение значимым в сторону уменьшения.\n","\n","H0: Среднее количество часов социальных взаимодействий у студентов с высоким уровнем стресса равно общему среднему.\n","\n","H1: Среднее количество часов социальных взаимодействий у студентов с высоким уровнем стресса ниже, чем общее среднее в выборке.\n","\n","Используем критерий проверки средних.\n"],"metadata":{"id":"zH89sBrtCVZs"}},{"cell_type":"code","source":["# Вычисляем средние\n","mean_social_hours = df['Social_Hours_Per_Day'].mean()\n","h_level_social = df[df['Stress_Level'] == \"High\"]['Social_Hours_Per_Day']\n","print(\"Общее среднее количество часов общения:\",mean_social_hours.round(3))\n","print(\"Среднее у студентов с высоким уровнем стресса:\",h_level_social.mean().round(3))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1777472255304,"user_tz":-180,"elapsed":23,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}},"outputId":"67f821d5-d8a8-4b20-f525-24842689a692","id":"S9rPA94w4dVt"},"execution_count":42,"outputs":[{"output_type":"stream","name":"stdout","text":["Общее среднее количество часов общения: 2.705\n","Среднее у студентов с высоким уровнем стресса: 2.628\n"]}]},{"cell_type":"code","source":["delta  = ((h_level_social.mean()- mean_social_hours)*math.sqrt(h_level_social.count()))/h_level_social.std()\n","\n","alpha = 0.05\n","\n","t_critical = -t.ppf(1 - alpha, h_level_social.count()-1)\n","print(f\"Критическое значение: {t_critical.round(3)}\")\n","if t_critical < delta:\n","    print(f\"Условие: {t_critical:.4f} < {delta:.4f} выполняется\")\n","    print(f\"Гипотеза не отвергается на уровне значимости {alpha}\")\n","else:\n","    print(f\"Условие: {t_critical:.4f} < {delta:.4f} не выполняется\")\n","    print(f\"Гипотеза отвергнута на уровне значимости {alpha}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"outputId":"41524e1d-299a-4152-db13-7051b2bdef69","executionInfo":{"status":"ok","timestamp":1777472255312,"user_tz":-180,"elapsed":7,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}},"id":"cf7Ps5mb4gG0"},"execution_count":43,"outputs":[{"output_type":"stream","name":"stdout","text":["Критическое значение: -1.646\n","Условие: -1.6463 < -1.4594 выполняется\n","Гипотеза не отвергается на уровне значимости 0.05\n"]}]},{"cell_type":"markdown","source":["##Вывод: Гипотеза H0 не отвергается на уровне значимости 0,05. Среднее количество часов социальных взаимодействий у студентов с высоким уровнем стресса равно общему среднему."],"metadata":{"id":"NL5Nk_gz4jKt"}},{"cell_type":"markdown","source":["## Гипотеза №5\n","\n","Проверим, отличается ли среднее время физических нагрузок(Physical_Activity_Hours_Per_Day) у студентов с высоким уровнем стресса, от общего среднего, и является ли это отклонение значимым в сторону уменьшения.\n","\n","H0: Среднее количество часов физических нагрузок у студентов с высоким уровнем стресса равно общему среднему.\n","\n","H1: Среднее количество часов физических нагрузок у студентов с высоким уровнем стресса ниже, чем общее среднее в выборке.\n","\n","Используем критерий проверки средних.\n"],"metadata":{"id":"nqmqaIw56LFI"}},{"cell_type":"code","source":["# Вычисляем средние\n","mean_pe_hours = df['Physical_Activity_Hours_Per_Day'].mean()\n","h_level_pe = df[df['Stress_Level'] == \"High\"]['Physical_Activity_Hours_Per_Day']\n","print(\"Общее среднее количество часов общения:\",mean_pe_hours.round(3))\n","print(\"Среднее у студентов с высоким уровнем стресса:\",h_level_pe.mean().round(3))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1777472255324,"user_tz":-180,"elapsed":8,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}},"outputId":"444b480e-2e2c-40c0-e9e6-b45837288e89","id":"B9kuAem36Nyk"},"execution_count":44,"outputs":[{"output_type":"stream","name":"stdout","text":["Общее среднее количество часов общения: 4.328\n","Среднее у студентов с высоким уровнем стресса: 3.961\n"]}]},{"cell_type":"code","source":["delta  = ((h_level_pe.mean()- mean_pe_hours)*math.sqrt(h_level_pe.count()))/h_level_pe.std()\n","\n","alpha = 0.05\n","\n","t_critical = -t.ppf(1 - alpha, h_level_pe.count()-1)\n","print(f\"Критическое значение: {t_critical.round(3)}\")\n","if t_critical < delta:\n","    print(f\"Условие: {t_critical:.4f} < {delta:.4f} выполняется\")\n","    print(f\"Гипотеза не отвергается на уровне значимости {alpha}\")\n","else:\n","    print(f\"Условие: {t_critical:.4f} < {delta:.4f} не выполняется\")\n","    print(f\"Гипотеза отвергнута на уровне значимости {alpha}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"outputId":"bcff3f79-532f-4ee5-cd22-158b05567608","executionInfo":{"status":"ok","timestamp":1777472255417,"user_tz":-180,"elapsed":90,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}},"id":"_ZMsp3no6QTb"},"execution_count":45,"outputs":[{"output_type":"stream","name":"stdout","text":["Критическое значение: -1.646\n","Условие: -1.6463 < -4.5256 не выполняется\n","Гипотеза отвергнута на уровне значимости 0.05\n"]}]},{"cell_type":"markdown","source":["##Вывод: Гипотеза H0 отклоняется в пользу H1 на уровне значимости 0,05. Среднее количество часов физических нагрузок у студентов с высоким уровнем стресса значимо ниже, чем общее среднее в выборке."],"metadata":{"id":"6j3Yl16b6TQn"}},{"cell_type":"markdown","source":["#Вывод по всем гипотезам: Студент с высоким уровнем стресса — это человек, который много учится, мало спит, недостаточно занимается спортом. Уровень социальной активности и пол студента не влияют на уровень стресса."],"metadata":{"id":"qHrEKlGlE2ya"}},{"cell_type":"markdown","source":["# Зависимости между поведенческими характеристиками студентов и их успеваемостью"],"metadata":{"id":"0oygLO_t1Wos"}},{"cell_type":"markdown","source":["Строим точечные диаграммы с линиями тренда"],"metadata":{"id":"fPzMEEN92R9D"}},{"cell_type":"code","source":["fig, axes = plt.subplots(3, 2, figsize=(10, 10))\n","fig.subplots_adjust(hspace=0.3, wspace=0.3)\n","\n","sns.regplot(x='Study_Hours_Per_Day', y='Grades', data=df, ax=axes[0,0],\n","            scatter_kws={'alpha':0.7, 's':5}, line_kws={'color':'red', 'linewidth':2})\n","sns.regplot(x='Extracurricular_Hours_Per_Day', y='Grades', data=df, ax=axes[0,1],\n","            scatter_kws={'alpha':0.7, 's':5}, line_kws={'color':'red', 'linewidth':2})\n","sns.regplot(x='Sleep_Hours_Per_Day', y='Grades', data=df, ax=axes[1,0],\n","            scatter_kws={'alpha':0.7, 's':5}, line_kws={'color':'red', 'linewidth':2})\n","sns.regplot(x='Social_Hours_Per_Day', y='Grades', data=df, ax=axes[1,1],\n","            scatter_kws={'alpha':0.7, 's':5}, line_kws={'color':'red', 'linewidth':2})\n","sns.regplot(x='Physical_Activity_Hours_Per_Day', y='Grades', data=df, ax=axes[2,0],\n","            scatter_kws={'alpha':0.7, 's':5}, line_kws={'color':'red', 'linewidth':2})\n","axes[2, 1].axis('off');"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":771},"id":"BtXkXPgqpo3k","executionInfo":{"status":"ok","timestamp":1777472257219,"user_tz":-180,"elapsed":1800,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}},"outputId":"267f0744-29e5-4fa9-97b6-bf42d5397c0f"},"execution_count":46,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x1000 with 6 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["##Вывод: Оценки имеют сильную положительную связь со временем, затраченным на учёбу и умеренную отрицательную связь с физической активностью."],"metadata":{"id":"QvZn04BiKjfS"}},{"cell_type":"markdown","source":["#Взаимосвязь между оценками и уровнем стресса"],"metadata":{"id":"QZLDv92zASn6"}},{"cell_type":"markdown","source":["Посчитаем медианную оценку у каждой группы студентов по уровню стресса"],"metadata":{"id":"NAhaUIxHBpwd"}},{"cell_type":"code","source":["medians = df.groupby('Stress_Level')['Grades'].median().reindex(['Low', 'Moderate', 'High'])\n","medians"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":264},"id":"zbHXXLgwB0zE","executionInfo":{"status":"ok","timestamp":1777472257282,"user_tz":-180,"elapsed":57,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}},"outputId":"17ac8302-0364-4bbb-b493-56150d4de14d"},"execution_count":47,"outputs":[{"output_type":"stream","name":"stderr","text":["/tmp/ipykernel_13061/1574556551.py:1: FutureWarning: The default of observed=False is deprecated and will be changed to True in a future version of pandas. Pass observed=False to retain current behavior or observed=True to adopt the future default and silence this warning.\n","  medians = df.groupby('Stress_Level')['Grades'].median().reindex(['Low', 'Moderate', 'High'])\n"]},{"output_type":"execute_result","data":{"text/plain":["Stress_Level\n","Low         7.05\n","Moderate    7.55\n","High        8.18\n","Name: Grades, dtype: float64"],"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Grades</th>\n","    </tr>\n","    <tr>\n","      <th>Stress_Level</th>\n","      <th></th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>Low</th>\n","      <td>7.05</td>\n","    </tr>\n","    <tr>\n","      <th>Moderate</th>\n","      <td>7.55</td>\n","    </tr>\n","    <tr>\n","      <th>High</th>\n","      <td>8.18</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div><br><label><b>dtype:</b> float64</label>"]},"metadata":{},"execution_count":47}]},{"cell_type":"markdown","source":["Строим ящики с усами"],"metadata":{"id":"eEbFk_v7AjMw"}},{"cell_type":"code","source":["sns.boxplot(data=df, x='Stress_Level', y='Grades',\n","            order=['Low', 'Moderate', 'High'],\n","            hue='Stress_Level',\n","            palette=['red','yellow','green']);"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":450},"id":"iwEVdWO2_VVO","executionInfo":{"status":"ok","timestamp":1777472257308,"user_tz":-180,"elapsed":19,"user":{"displayName":"Екатерина Горнова","userId":"13323579026774832496"}},"outputId":"820b89ca-da90-4007-b856-2fa35bec5d7b"},"execution_count":48,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["##Вывод: У студентов с хорошими оценками высокий уровень стресса."],"metadata":{"id":"-nQ_ku7lAzXD"}},{"cell_type":"markdown","source":["#Общий вывод:\n","\n","Анализ данных показал, что имеется четкая взаимосвязь между академической нагрузкой, образом жизни и психоэмоциональным состоянием студентов. Высокий уровень стресса тесно связан с низкой продолжительностью сна, повышенной учебной нагрузкой и сниженной физической активностью. Выявлена сильная корреляция между временем, затраченным на учёбу и оценками, а также умеренная отрицательная связь оценок и физической активности — интенсивные занятия вытесняют спорт.\n","\n","Закономерным итогом становится парадоксальная картина: хорошие оценки сопровождаются высоким уровнем стресса.  Высокая академическая успеваемость достигается ценой роста учебной нагрузки, сокращения сна и физической активности.\n","\n","Таким образом, для здорового и устойчивого успеха студентам необходимы меры по снижению стресса, соблюдение режима сна и включение физической активности в расписание.\n","\n"],"metadata":{"id":"fXKYCM3ehdyr"}}]}